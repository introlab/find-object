{
    "build": {
      "dockerfile": "Dockerfile",
      "pull": true
    },
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
          "extensions": [
            "ms-vscode.cpptools-themes",
            "ms-vscode.cmake-tools",
            "ms-vscode.cpptools-extension-pack",
            "ms-azuretools.vscode-docker",
            "ms-python.python"]
        }
      },
    "settings": {
      "python.autoComplete.extraPaths": [
        "/opt/ros/noetic/lib/python3/dist-packages"
      ],
      "terminal.integrated.defaultProfile.linux": "bash"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/catkin_ws/src/find_object_2d,type=bind",
    "workspaceFolder": "/home/vscode/catkin_ws",
    "postCreateCommand": "rosdep update && sudo apt update && rosdep install --from-paths ~/catkin_ws/src/find_object_2d -i -y && echo 'Initialize: catkin_make -DCMAKE_BUILD_TYPE=Release'",
    "hostRequirements": {
        "gpu": "optional"
    },
    "runArgs": ["--privileged",
                "--gpus=all",
                //"--runtime=nvidia", // uncommment this if find_object doesn't show up in nvidia-smi on the host computer
                "--env=DISPLAY",
                "--env=QT_X11_NO_MITSHM=1",
                "--volume=/tmp/.X11-unix:/tmp/.X11-unix"],
    "containerEnv": {
        "NVIDIA_VISIBLE_DEVICES": "all"
    }
}
